{
  "name": "bitcoin-payment-verifier",
  "version": "0.1.0",
  "description": "Verify Bitcoin payments without a full node using BIP-157/158 compact block filters or Electrum protocol",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "author": "Maheswaran Velmurugan",
  "repository": {
    "type": "git",
    "url": "https://github.com/soloking1412/bitcoin-payment-verifier"
  },
  "keywords": [
    "bitcoin",
    "payment",
    "verification",
    "bip157",
    "bip158",
    "electrum",
    "neutrino"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc --watch",
    "start": "node dist/api/server.js",
    "dev": "ts-node src/api/server.ts",
    "test": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:all": "jest",
    "test:coverage": "jest --coverage --testPathPattern=unit",
    "lint": "tsc --noEmit",
    "docker:build": "docker build -t bitcoin-payment-verifier .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "bitcoinjs-lib": "^6.1.5",
    "express": "^4.18.2",
    "level": "^8.0.0",
    "tiny-secp256k1": "^2.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
